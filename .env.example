# 1. Google Gemini (Primary Active Engine - Multimodal SQL & Architecture)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# 2. DeepSeek (DeepSeek V3 - High-capability Code & Architecture)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# 3. OpenAI (GPT-4o Mini - Query Optimization & Reasoning)
OPENAI_API_KEY="your-openai-api-key-here"

# 4. Anthropic (Claude 3.5 Sonnet - DDL Design & Analysis)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Application URL
APP_URL="http://localhost:3000"

# Optional: Google OAuth 2.0 Credentials (SSO)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
